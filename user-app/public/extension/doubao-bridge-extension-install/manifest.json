{
  "manifest_version": 3,
  "name": "衣秀 · 豆包填入",
  "version": "1.0.7",
  "key": "",
  "description": "从衣秀自动填入豆包对话：提示词 + 模特场景图，生成带货短视频",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.doubao.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "豆包填入助手",
    "default_popup": "popup.html"
  }
}
